# Copy to .env.e2e (gitignored) so `pnpm test:e2e` needs no arguments.
# Anything you set on the command line still wins over this file.

# Admin account the suite seeds with. The password is generated on the backend's FIRST
# boot and printed only to its log — search it for "Admin user password:".
E2E_ADMIN_USER=admin
E2E_ADMIN_PASSWORD=REPLACE_ME

# Backend origin. On macOS, port 5000 is taken by AirPlay Receiver — if you moved the
# backend, point both this and VITE_API_URL at the new port.
# E2E_API_URL=http://127.0.0.1:5000

# Run Vite on a port of the suite's own, so an already-running `pnpm dev` (which proxies
# /api to whatever VITE_API_URL said when IT started) is not reused.
# E2E_PORT=5199
