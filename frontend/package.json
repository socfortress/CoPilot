{
	"name": "copilot",
	"type": "module",
	"version": "1.0.0",
	"private": true,
	"packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"dev": "vite --host 0.0.0.0",
		"dev:debug": "DEBUG=vite:* vite",
		"build": "run-p type-check \"build:only {@}\" --",
		"build:only": "vite build",
		"build:docker": "docker build .",
		"build:analyzer": "vite-bundle-visualizer -t sunburst",
		"build:check": "run-s libs:reload lint-type-format build test:unit build:docker",
		"preview": "vite build && echo '' && vite preview --port 4173 --host",
		"preview:only": "vite preview --port 4173 --host",
		"test:unit": "vitest run",
		"dup-check": "jscpd --ignore \"**/node_modules/**,**/dist/**,**/.nuxt/**,**/*.svg\" --min-tokens 100 --reporters console,html,json .",
		"type-check": "vue-tsc --build --force tsconfig.app.json",
		"lint": "eslint . --fix",
		"format": "prettier --write src/",
		"lint-type-format": "run-s lint type-check format",
		"design-tokens": "node scripts/tokens-tool.js",
		"start-server:old": "cd ../backend && uvicorn copilot:app --reload --port=5000",
		"start-server:venv": "cd ../backend && source .venv/bin/activate && uvicorn copilot:app --port=5000 --log-level debug",
		"start-server": "cd ../backend && /opt/venv/bin/python copilot.py",
		"start-frontend": "vite --host 0.0.0.0",
		"start": "concurrently \"pnpm start-server\" \"pnpm start-frontend\"",
		"libs:check": "taze && depcheck",
		"libs:reload": "rm -rf node_modules pnpm-lock.yaml && pnpm install",
		"open:swagger": "open http://127.0.0.1:5000/docs#/",
		"open:redoc": "open http://127.0.0.1:5000/redoc"
	},
	"dependencies": {
		"@ajoelp/json-to-formdata": "^1.5.0",
		"@codemirror/commands": "^6.11.0",
		"@codemirror/lang-xml": "^6.1.0",
		"@codemirror/lint": "^6.9.7",
		"@codemirror/state": "^6.7.1",
		"@codemirror/theme-one-dark": "^6.1.3",
		"@codemirror/view": "^6.43.9",
		"@f3ve/vue-markdown-it": "^0.2.3",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@fontsource/lexend": "^5.3.0",
		"@fontsource/public-sans": "^5.3.0",
		"@microsoft/fetch-event-source": "^2.0.1",
		"@mui/material": "^9.4.0",
		"@oreo-design/avatar": "^0.1.0",
		"@shikijs/markdown-it": "^4.4.3",
		"@shuffleio/shuffle-mcps": "^0.0.37",
		"@simplewebauthn/browser": "^13.3.0",
		"@vueuse/core": "^14.4.0",
		"@vueuse/motion": "^3.0.3",
		"axios": "^1.20.0",
		"bytes": "^3.1.2",
		"colord": "^2.10.0",
		"dayjs": "^1.11.23",
		"detect-touch-device": "^1.1.6",
		"echarts": "^6.1.0",
		"fast-xml-parser": "^5.11.1",
		"file-saver": "^2.0.5",
		"fuse.js": "^7.5.0",
		"html-entities": "^2.6.0",
		"jose": "^6.2.10",
		"js-md5": "^0.9.2",
		"lodash": "^4.18.1",
		"naive-ui": "^2.45.3",
		"nanoid": "^6.0.1",
		"papaparse": "^5.7.0",
		"password-generator": "^3.0.0",
		"password-validator": "^5.3.0",
		"pinia": "^4.0.3",
		"pinia-plugin-persistedstate": "^4.7.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"secure-ls": "^2.0.0",
		"shiki": "^4.4.3",
		"thememirror": "^2.0.1",
		"validator": "^13.15.35",
		"vue": "^3.5.42",
		"vue-advanced-cropper": "^2.8.9",
		"vue-codemirror": "^6.1.1",
		"vue-echarts": "^8.1.0",
		"vue-i18n": "^11.4.10",
		"vue-router": "^5.3.0",
		"vue-sjv": "^0.0.6",
		"vuedraggable": "^4.1.0",
		"xmllint-wasm": "^5.3.0"
	},
	"optionalDependencies": {
