{
 "aggs": {
  "endpoints": {
   "cardinality": {
    "field": "agent.id",
    "precision_threshold": 3000
   }
  },
  "quiet": {
   "aggs": {
    "by_event": {
     "aggs": {
      "actor_Image": {
       "aggs": {
        "endpoints": {
         "cardinality": {
          "field": "agent.id",
          "precision_threshold": 1000
         }
        }
       },
       "terms": {
        "field": "data.win.eventdata.image",
        "size": 25
       }
      },
      "actor_ImageLoaded": {
       "aggs": {
        "endpoints": {
         "cardinality": {
          "field": "agent.id",
          "precision_threshold": 1000
         }
        }
       },
       "terms": {
        "field": "data.win.eventdata.imageLoaded",
        "size": 25
       }
      },
      "actor_SourceImage": {
       "aggs": {
        "endpoints": {
         "cardinality": {
          "field": "agent.id",
          "precision_threshold": 1000
         }
        }
       },
       "terms": {
        "field": "data.win.eventdata.sourceImage",
        "size": 25
       }
      }
     },
     "terms": {
      "field": "data.win.system.eventID",
      "size": 18
     }
    }
   },
   "filter": {
    "bool": {
     "filter": [
      {
       "terms": {
        "rule.level": [
         0,
         1,
         2,
         3,
         4,
         5
        ]
       }
      },
      {
       "terms": {
        "data.win.system.eventID": [
         "1",
         "2",
         "3",
         "6",
         "7",
         "8",
         "10",
         "11",
         "12",
         "13",
         "14",
         "15",
         "17",
         "18",
         "22",
         "23",
         "25",
         "26"
        ]
       }
      }
     ]
    }
   }
  }
 },
 "query": {
  "bool": {
   "filter": [
    {
     "range": {
      "timestamp": {
       "format": "epoch_millis",
       "gte": 1794787200000,
       "lt": 1795392000000
      }
     }
    },
    {
     "term": {
      "data.win.system.channel": "Microsoft-Windows-Sysmon/Operational"
     }
    },
    {
     "terms": {
      "agent.labels.customer": [
       "acme",
       "ACME"
      ]
     }
    }
   ]
  }
 },
 "size": 0,
 "track_total_hits": false
}
