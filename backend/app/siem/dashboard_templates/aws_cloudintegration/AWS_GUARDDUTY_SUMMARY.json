{
  "id": "AWS_GUARDDUTY_SUMMARY",
  "title": "AWS GuardDuty - Findings Summary",
  "description": "Amazon GuardDuty findings: volume by severity band (medium, high, critical), finding types, regions, the resources affected, and the most recent findings.",
  "panels": [
    {
      "id": "total_findings",
      "title": "Findings",
      "type": "stat",
      "w": 3,
      "h": 100,
      "lucene": "data_aws_source:guardduty"
    },
    {
      "id": "medium_findings",
      "title": "Medium Severity",
      "type": "stat",
      "w": 3,
      "h": 100,
      "lucene": "data_aws_source:guardduty AND data_aws_severity:/[4-6](\\.[0-9]+)?/"
    },
    {
      "id": "high_findings",
      "title": "High Severity",
      "type": "stat",
      "w": 3,
      "h": 100,
      "lucene": "data_aws_source:guardduty AND data_aws_severity:/[7-8](\\.[0-9]+)?/"
    },
    {
      "id": "critical_findings",
      "title": "Critical Severity",
      "type": "stat",
      "w": 3,
      "h": 100,
      "lucene": "data_aws_source:guardduty AND data_aws_severity:/(9(\\.[0-9]+)?|10(\\.0+)?)/"
    },
    {
      "id": "findings_over_time",
      "title": "Findings Over Time",
      "type": "histogram",
      "w": 12,
      "h": 200,
      "lucene": "data_aws_source:guardduty"
    },
    {
      "id": "by_severity",
      "title": "Findings by Severity",
      "type": "pie",
      "w": 4,
      "h": 300,
      "lucene": "data_aws_source:guardduty",
      "field": "data_aws_severity",
      "size": 10
    },
    {
      "id": "by_action_type",
      "title": "Findings by Activity",
      "type": "pie",
      "w": 4,
      "h": 300,
      "lucene": "data_aws_source:guardduty",
      "field": "data_aws_service_action_actionType",
      "size": 10
    },
    {
      "id": "by_region",
      "title": "Findings by Region",
      "type": "pie",
      "w": 4,
      "h": 300,
      "lucene": "data_aws_source:guardduty",
      "field": "data_aws_region",
      "size": 10
    },
    {
      "id": "top_finding_types",
      "title": "Top Finding Types",
      "type": "bar_h",
      "w": 6,
      "h": 320,
      "lucene": "data_aws_source:guardduty",
      "field": "data_aws_type",
      "size": 15
    },
    {
      "id": "affected_instances",
      "title": "Affected EC2 Instances",
      "type": "bar_h",
      "w": 6,
      "h": 320,
      "lucene": "data_aws_source:guardduty",
      "field": "data_aws_resource_instanceDetails_instanceId",
      "size": 15
    },
    {
      "id": "by_resource_type",
      "title": "Affected Resource Types",
      "type": "bar_h",
      "w": 6,
      "h": 320,
      "lucene": "data_aws_source:guardduty",
      "field": "data_aws_resource_resourceType",
      "size": 15
    },
    {
      "id": "by_title",
      "title": "Top Findings",
      "type": "bar_h",
      "w": 6,
      "h": 320,
      "lucene": "data_aws_source:guardduty",
      "field": "data_aws_title",
      "size": 15
    },
    {
      "id": "recent_findings",
      "title": "Recent Findings",
      "type": "table",
      "w": 12,
      "h": 420,
      "lucene": "data_aws_source:guardduty",
      "fields": [
        "timestamp",
        "data_aws_severity",
        "data_aws_type",
        "data_aws_title",
        "data_aws_resource_instanceDetails_instanceId",
        "data_aws_region",
        "data_aws_service_count"
      ],
      "size": 50
    }
  ]
}
