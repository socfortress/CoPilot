{
  "id": "AWS_CLOUDTRAIL_IAM",
  "title": "AWS CloudTrail - IAM & Access Changes",
  "description": "Every write call to IAM: users and access keys created, policies created, attached and detached, who made each change, which users and policies it touched, and from where.",
  "panels": [
    {
      "id": "iam_changes",
      "title": "IAM Changes",
      "type": "stat",
      "w": 3,
      "h": 100,
      "lucene": "data_aws_source:cloudtrail AND data_aws_eventSource:iam.amazonaws.com AND data_aws_readOnly:false"
    },
    {
      "id": "users_created",
      "title": "Users Created",
      "type": "stat",
      "w": 3,
      "h": 100,
      "lucene": "data_aws_source:cloudtrail AND data_aws_eventName:CreateUser"
    },
    {
      "id": "access_keys_created",
      "title": "Access Keys Created",
      "type": "stat",
      "w": 3,
      "h": 100,
      "lucene": "data_aws_source:cloudtrail AND data_aws_eventName:CreateAccessKey"
    },
    {
      "id": "policy_changes",
      "title": "Policy Changes",
      "type": "stat",
      "w": 3,
      "h": 100,
      "lucene": "data_aws_source:cloudtrail AND data_aws_eventName:(AttachUserPolicy OR AttachRolePolicy OR AttachGroupPolicy OR PutUserPolicy OR PutRolePolicy OR PutGroupPolicy OR CreatePolicy OR CreatePolicyVersion OR DetachUserPolicy OR DetachRolePolicy OR DetachGroupPolicy)"
    },
    {
      "id": "iam_changes_over_time",
      "title": "IAM Changes Over Time",
      "type": "histogram",
      "w": 12,
      "h": 200,
      "lucene": "data_aws_source:cloudtrail AND data_aws_eventSource:iam.amazonaws.com AND data_aws_readOnly:false"
    },
    {
      "id": "by_api_call",
      "title": "Changes by API Call",
      "type": "bar_h",
      "w": 6,
      "h": 320,
      "lucene": "data_aws_source:cloudtrail AND data_aws_eventSource:iam.amazonaws.com AND data_aws_readOnly:false",
      "field": "data_aws_eventName",
      "size": 15
    },
    {
      "id": "by_actor",
      "title": "Changes by Actor",
      "type": "bar_h",
      "w": 6,
      "h": 320,
      "lucene": "data_aws_source:cloudtrail AND data_aws_eventSource:iam.amazonaws.com AND data_aws_readOnly:false",
      "field": "data_aws_userIdentity_arn",
      "size": 15
    },
    {
      "id": "target_users",
      "title": "Users Changed",
      "type": "bar_h",
      "w": 6,
      "h": 320,
      "lucene": "data_aws_source:cloudtrail AND data_aws_eventSource:iam.amazonaws.com AND data_aws_readOnly:false",
      "field": "data_aws_requestParameters_userName",
      "size": 15
    },
    {
      "id": "policies",
      "title": "Policies Attached or Changed",
      "type": "bar_h",
      "w": 6,
      "h": 320,
      "lucene": "data_aws_source:cloudtrail AND data_aws_eventSource:iam.amazonaws.com AND data_aws_readOnly:false",
      "field": "data_aws_requestParameters_policyArn",
      "size": 15
    },
    {
      "id": "by_actor_type",
      "title": "Actor Identity Type",
      "type": "pie",
      "w": 4,
      "h": 300,
      "lucene": "data_aws_source:cloudtrail AND data_aws_eventSource:iam.amazonaws.com AND data_aws_readOnly:false",
      "field": "data_aws_userIdentity_type",
      "size": 10
    },
    {
      "id": "by_source_ip",
      "title": "Changes by Source IP",
      "type": "pie",
      "w": 4,
      "h": 300,
      "lucene": "data_aws_source:cloudtrail AND data_aws_eventSource:iam.amazonaws.com AND data_aws_readOnly:false",
      "field": "data_aws_sourceIPAddress",
      "size": 10
    },
    {
      "id": "by_result",
      "title": "Failed Changes by Error",
      "type": "pie",
      "w": 4,
      "h": 300,
      "lucene": "data_aws_source:cloudtrail AND data_aws_eventSource:iam.amazonaws.com AND data_aws_readOnly:false AND data_aws_errorCode:*",
      "field": "data_aws_errorCode",
      "size": 10
    },
    {
      "id": "recent_changes",
      "title": "Recent IAM Changes",
      "type": "table",
      "w": 12,
      "h": 420,
      "lucene": "data_aws_source:cloudtrail AND data_aws_eventSource:iam.amazonaws.com AND data_aws_readOnly:false",
      "fields": [
        "timestamp",
        "data_aws_eventName",
        "data_aws_userIdentity_arn",
        "data_aws_requestParameters_userName",
        "data_aws_requestParameters_policyArn",
        "data_aws_sourceIPAddress",
        "data_aws_errorCode"
      ],
      "size": 50
    }
  ]
}
