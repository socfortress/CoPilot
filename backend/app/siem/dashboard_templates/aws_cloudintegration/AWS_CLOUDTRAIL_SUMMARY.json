{
  "id": "AWS_CLOUDTRAIL_SUMMARY",
  "title": "AWS CloudTrail - Summary",
  "description": "Overview of AWS API activity recorded by CloudTrail: event volume, write (mutating) calls, failed calls, notable events, the services and regions in use, who is calling the APIs and from where, and the most recent events.",
  "panels": [
    {
      "id": "total_events",
      "title": "Total Events",
      "type": "stat",
      "w": 3,
      "h": 100,
      "lucene": "data_aws_source:cloudtrail"
    },
    {
      "id": "write_events",
      "title": "Write Calls (not by AWS services)",
      "type": "stat",
      "w": 3,
      "h": 100,
      "lucene": "data_aws_source:cloudtrail AND data_aws_readOnly:false AND NOT data_aws_userIdentity_invokedBy:*"
    },
    {
      "id": "failed_calls",
      "title": "Failed API Calls",
      "type": "stat",
      "w": 3,
      "h": 100,
      "lucene": "data_aws_source:cloudtrail AND data_aws_errorCode:*"
    },
    {
      "id": "notable_events",
      "title": "Notable Events (rule level ≥ 7)",
      "type": "stat",
      "w": 3,
      "h": 100,
      "lucene": "data_aws_source:cloudtrail AND rule_level:>=7"
    },
    {
      "id": "events_over_time",
      "title": "Events Over Time",
      "type": "histogram",
      "w": 12,
      "h": 200,
      "lucene": "data_aws_source:cloudtrail"
    },
    {
      "id": "by_event_source",
      "title": "Events by AWS Service",
      "type": "pie",
      "w": 4,
      "h": 300,
      "lucene": "data_aws_source:cloudtrail",
      "field": "data_aws_eventSource",
      "size": 10
    },
    {
      "id": "by_region",
      "title": "Events by Region",
      "type": "pie",
      "w": 4,
      "h": 300,
      "lucene": "data_aws_source:cloudtrail",
      "field": "data_aws_awsRegion",
      "size": 10
    },
    {
      "id": "by_identity_type",
      "title": "Events by Identity Type",
      "type": "pie",
      "w": 4,
      "h": 300,
      "lucene": "data_aws_source:cloudtrail",
      "field": "data_aws_userIdentity_type",
      "size": 10
    },
    {
      "id": "top_api_calls",
      "title": "Top API Calls",
      "type": "bar_h",
      "w": 6,
      "h": 320,
      "lucene": "data_aws_source:cloudtrail",
      "field": "data_aws_eventName",
      "size": 15
    },
    {
      "id": "top_identities",
      "title": "Top Identities",
      "type": "bar_h",
      "w": 6,
      "h": 320,
      "lucene": "data_aws_source:cloudtrail",
      "field": "data_aws_userIdentity_arn",
      "size": 15
    },
    {
      "id": "top_source_ips",
      "title": "Top Source IPs",
      "type": "bar_h",
      "w": 6,
      "h": 320,
      "lucene": "data_aws_source:cloudtrail",
      "field": "data_aws_sourceIPAddress",
      "size": 15
    },
    {
      "id": "by_country",
      "title": "Events by Source Country",
      "type": "bar_h",
      "w": 6,
      "h": 320,
      "lucene": "data_aws_source:cloudtrail",
      "field": "data_aws_sourceIPAddress_country_code",
      "size": 15
    },
    {
      "id": "top_rules",
      "title": "Top Wazuh Rules",
      "type": "bar_h",
      "w": 12,
      "h": 320,
      "lucene": "data_aws_source:cloudtrail",
      "field": "rule_description",
      "size": 10
    },
    {
      "id": "recent_events",
      "title": "Recent Events",
      "type": "table",
      "w": 12,
      "h": 420,
      "lucene": "data_aws_source:cloudtrail",
      "fields": [
        "timestamp",
        "data_aws_eventName",
        "data_aws_eventSource",
        "data_aws_userIdentity_arn",
        "data_aws_sourceIPAddress",
        "data_aws_awsRegion",
        "data_aws_errorCode",
        "rule_level"
      ],
      "size": 50
    }
  ]
}
