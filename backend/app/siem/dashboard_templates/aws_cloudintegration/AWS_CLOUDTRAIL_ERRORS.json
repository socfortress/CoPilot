{
  "id": "AWS_CLOUDTRAIL_ERRORS",
  "title": "AWS CloudTrail - Denied & Failed API Calls",
  "description": "API calls AWS refused: access denied and unauthorized operations (often reconnaissance or a stolen key probing its permissions), throttling, and every other error — by error code, API call, identity and source IP.",
  "panels": [
    {
      "id": "failed_calls",
      "title": "Failed API Calls",
      "type": "stat",
      "w": 3,
      "h": 100,
      "lucene": "data_aws_source:cloudtrail AND data_aws_errorCode:*"
    },
    {
      "id": "access_denied",
      "title": "Access Denied",
      "type": "stat",
      "w": 3,
      "h": 100,
      "lucene": "data_aws_source:cloudtrail AND data_aws_errorCode:(AccessDenied OR AccessDeniedException OR UnauthorizedOperation OR Client.UnauthorizedOperation)"
    },
    {
      "id": "throttled",
      "title": "Throttled",
      "type": "stat",
      "w": 3,
      "h": 100,
      "lucene": "data_aws_source:cloudtrail AND data_aws_errorCode:(ThrottlingException OR Throttling OR RequestLimitExceeded)"
    },
    {
      "id": "failed_writes",
      "title": "Failed Write Calls",
      "type": "stat",
      "w": 3,
      "h": 100,
      "lucene": "data_aws_source:cloudtrail AND data_aws_errorCode:* AND data_aws_readOnly:false"
    },
    {
      "id": "failed_over_time",
      "title": "Failed Calls Over Time",
      "type": "histogram",
      "w": 12,
      "h": 200,
      "lucene": "data_aws_source:cloudtrail AND data_aws_errorCode:*"
    },
    {
      "id": "by_error_code",
      "title": "Failed Calls by Error Code",
      "type": "pie",
      "w": 4,
      "h": 300,
      "lucene": "data_aws_source:cloudtrail AND data_aws_errorCode:*",
      "field": "data_aws_errorCode",
      "size": 10
    },
    {
      "id": "by_event_source",
      "title": "Failed Calls by AWS Service",
      "type": "pie",
      "w": 4,
      "h": 300,
      "lucene": "data_aws_source:cloudtrail AND data_aws_errorCode:*",
      "field": "data_aws_eventSource",
      "size": 10
    },
    {
      "id": "by_region",
      "title": "Failed Calls by Region",
      "type": "pie",
      "w": 4,
      "h": 300,
      "lucene": "data_aws_source:cloudtrail AND data_aws_errorCode:*",
      "field": "data_aws_awsRegion",
      "size": 10
    },
    {
      "id": "by_api_call",
      "title": "Failed Calls by API Call",
      "type": "bar_h",
      "w": 6,
      "h": 320,
      "lucene": "data_aws_source:cloudtrail AND data_aws_errorCode:*",
      "field": "data_aws_eventName",
      "size": 15
    },
    {
      "id": "by_identity",
      "title": "Failed Calls by Identity",
      "type": "bar_h",
      "w": 6,
      "h": 320,
      "lucene": "data_aws_source:cloudtrail AND data_aws_errorCode:*",
      "field": "data_aws_userIdentity_arn",
      "size": 15
    },
    {
      "id": "by_source_ip",
      "title": "Failed Calls by Source IP",
      "type": "bar_h",
      "w": 6,
      "h": 320,
      "lucene": "data_aws_source:cloudtrail AND data_aws_errorCode:*",
      "field": "data_aws_sourceIPAddress",
      "size": 15
    },
    {
      "id": "by_country",
      "title": "Failed Calls by Source Country",
      "type": "bar_h",
      "w": 6,
      "h": 320,
      "lucene": "data_aws_source:cloudtrail AND data_aws_errorCode:*",
      "field": "data_aws_sourceIPAddress_country_code",
      "size": 15
    },
    {
      "id": "recent_failures",
      "title": "Recent Failed Calls",
      "type": "table",
      "w": 12,
      "h": 420,
      "lucene": "data_aws_source:cloudtrail AND data_aws_errorCode:*",
      "fields": [
        "timestamp",
        "data_aws_eventName",
        "data_aws_errorCode",
        "data_aws_errorMessage",
        "data_aws_userIdentity_arn",
        "data_aws_sourceIPAddress",
        "data_aws_awsRegion"
      ],
      "size": 50
    }
  ]
}
